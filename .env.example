# Токен Telegram-бота от @BotFather (обязательно)
TELEGRAM_TOKEN=123456789:AA-your-token-here

# Какие площадки опрашивать (через запятую). Пусто = все.
# Доступные ключи: lisskins, csmoney, aimmarket, steam
ENABLED_PROVIDERS=lisskins,csmoney,aimmarket,steam

# Таймаут запроса к площадкам, секунд
REQUEST_TIMEOUT=30

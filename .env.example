# Токен Telegram-бота от @BotFather (обязательно)
TELEGRAM_TOKEN=123456789:AA-your-token-here

# Какие площадки опрашивать (через запятую). Пусто = набор по умолчанию.
# Надёжные, без ключей:      lisskins, skinport, steam
# Опционально (нужен ключ):  csfloat  (см. CSFLOAT_API_KEY ниже)
# Нестабильные (Cloudflare): csmoney, aimmarket
ENABLED_PROVIDERS=lisskins,skinport,steam

# Ключ CSFloat (необязательно). Берётся бесплатно в профиле на csfloat.com.
# Если задан — можно добавить csfloat в ENABLED_PROVIDERS.
CSFLOAT_API_KEY=

# Таймаут запроса к площадкам, секунд
REQUEST_TIMEOUT=15
